{
  "manifest_version": 3,
  "name": "Kodland Tutor Assistant",
  "version": "1.0.0",
  "description": "أداة واتساب لمعلّمي Kodland: إرسال رسائل الترحيب والملخصات الأسبوعية وتذكيرات الحصص لأولياء الأمور.",
  "host_permissions": [
    "https://bo.kodland.org/*",
    "https://backoffice.kodland.org/*"
  ],
  "action": {
    "default_title": "Kodland Tutor Assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://bo.kodland.org/*"],
      "js": ["open-wa-button.js", "send-credential-button.js", "group-students-info.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}

